# Comma-separated list of accepted API keys (required to call the analyze endpoints)
PANELS_API_KEYS=change-me
PANELS_RATE_LIMIT_PER_MINUTE=60
PANELS_MAX_IMAGE_BYTES=15728640
PANELS_MAX_IMAGE_PIXELS=40000000
PANELS_URL_FETCH_TIMEOUT_SECONDS=10
PANELS_URL_MAX_REDIRECTS=3
# Development only: allow fetching from private/loopback addresses
PANELS_ALLOW_PRIVATE_URLS=false
# Development only: serve the /demo test page
PANELS_ENABLE_DEMO_PAGE=false
PANELS_SAMPLES_DIR=samples
PANELS_FIXTURES_DIR=tests/fixtures
# Panel detector: projection (gutter-based, default), classical (contour-based),
# ml (ONNX model) or hybrid (projection first, the model when projection looks unreliable)
PANELS_DETECTOR=projection
# PANELS_REFINE_EDGES=false
# PANELS_REFINE_MAX_EXPAND=0.15
# Extend each panel's top edge over the narration and balloons hanging above its frame
# PANELS_CLAIM_CAPTIONS=false
# ml and hybrid need the `ml` extra and a model file you are allowed to use (docs/adr/0002)
# PANELS_ML_MODEL=/models/panels.onnx
# PANELS_ML_INPUT_SIZE=640
# PANELS_ML_CONFIDENCE=0.25
# PANELS_ML_NMS_IOU=0.45
# PANELS_ML_OUTPUT_FORMAT=yolov8
# PANELS_ML_PANEL_CLASS=0
PANELS_LOG_LEVEL=INFO
PANELS_LOG_JSON=true
